# Copy to .env (never commit .env). Real environment variables win over this file.
MOCK_GEMINI=true
# Live mode only:
# GEMINI_API_KEY=            # or inject from a secrets manager
# SESSION_SECRET=            # long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
# COOKIE_SECURE=true         # set when served over HTTPS
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/trainer_assessment   # default: SQLite in ./data
# STORAGE_BACKEND=gcs
# GCS_BUCKET=
# Policy knobs (defaults shown)
# SCORE_FLOOR_MODE=accept     # accept | zero_anchor
# BAND_ROUNDING_RULE=threshold  # threshold | round_half_up
# MIN_COVERAGE_POINTS=70
# USD_INR=90

# --- Docker / company deployment (docker-compose.yml) ---
# POSTGRES_PASSWORD=
# SITE_ADDRESS=assessments.yourcompany.com
# DELETE_VIDEO_AFTER_ASSESSMENT=true
# MIN_FREE_DISK_GB=1.5
# PUBLIC_BASE_URL=https://assessments.yourcompany.com
# MIN_EFFECTIVE_MINUTES=60
# GAP_TOLERANCE_SECONDS=120   # pauses up to this long are forgiven
# GAP_FLAG_SECONDS=180        # pauses longer than this are flagged
# COUNT_PARTICIPANT_ACTIVITY_AS_EFFECTIVE=true
# GAP_FLAG_SECONDS=150          # 2.5 minutes
# INVOICE_SHORTFALL_MINUTES=5   # flag when the recording covers this much less than invoiced
# VIDEO_RESOLUTION=             # empty = default (low, ~100 tokens/s); high = clearer text, ~3x cost

# Optional: let the server open PRIVATE OneDrive/SharePoint links (Microsoft Entra app, read-only). Leave empty to use
# 'Anyone with the link' shares only.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
